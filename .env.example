# Copie para .env.local (ignorado pelo git) e preencha. Nada aqui deve ir para o repositório com valores reais.
# Variáveis SEM o prefixo NEXT_PUBLIC_ existem apenas no servidor e nunca chegam ao navegador.

# --- Modo da aplicação (fixo por deploy) -----------------------------------------------------
# "demo": dados fictícios no navegador, sem backend (desenvolvimento, previews, testes E2E).
# "live": Supabase + dados reais (produção). Exige as variáveis do Supabase e CRON_SECRET.
NEXT_PUBLIC_APP_MODE=demo

# --- Supabase (obrigatórias em "live") ---------------------------------------------------------
# Painel do projeto > Project Settings > API. A chave é a *publishable* (sb_publishable_...).
# NUNCA use a secret/service_role: o app foi desenhado para não precisar dela.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Cron (obrigatória em "live") ------------------------------------------------------------
# Segredo com 16+ caracteres. A Vercel o envia como "Authorization: Bearer ..." ao chamar o cron
# de keep-alive, que impede o Supabase gratuito de pausar por inatividade.
CRON_SECRET=

# --- Assistente de IA (opcional) -------------------------------------------------------------
# Sem provedor o app inteiro funciona; só o assistente e o "Lançar por texto" ficam ocultos.
# AI_PROVIDER: "groq" (tem camada gratuita, com limites), "xai" (Grok, pago) ou "none".
# Confira modelos, limites e preços no console do provedor. Não aderir a programas de "compartilhamento de dados".
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
# Opcional: o padrão vem do provedor (groq: https://api.groq.com/openai/v1, xai: https://api.x.ai/v1).
AI_BASE_URL=
# Tetos de uso por usuário (o app para de chamar o provedor ao atingir qualquer um deles).
AI_DAILY_REQUEST_LIMIT=60
AI_PER_MINUTE_LIMIT=10
AI_MONTHLY_TOKEN_BUDGET=500000
